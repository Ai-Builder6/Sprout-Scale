rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Master Gate Helper for Child Ownership
    function isParentChildOwner(childId) {
      return exists(/databases/$(database)/documents/children/$(childId)) &&
        get(/databases/$(database)/documents/children/$(childId)).data.ownerId == request.auth.uid;
    }

    // Validation Blueprint: ChildProfile
    function isValidChildProfile(data) {
      return data.keys().hasAll([
          'ownerId',
          'name',
          'ageTwoHeightCm',
          'ageTwoWeightKg',
          'paletteId',
          'accessoryId',
          'hairStyle',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'name',
          'ageTwoHeightCm',
          'ageTwoWeightKg',
          'paletteId',
          'accessoryId',
          'hairStyle',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string &&
        data.ownerId.size() >= 1 &&
        data.ownerId.size() <= 128 &&
        data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 50 &&
        data.ageTwoHeightCm is number &&
        data.ageTwoHeightCm >= 70 &&
        data.ageTwoHeightCm <= 115 &&
        data.ageTwoWeightKg is number &&
        data.ageTwoWeightKg >= 8 &&
        data.ageTwoWeightKg <= 25 &&
        data.paletteId is string &&
        data.paletteId.size() >= 1 &&
        data.paletteId.size() <= 16 &&
        data.paletteId in ['sunny', 'meadow', 'ocean', 'berry'] &&
        data.accessoryId is string &&
        data.accessoryId.size() >= 1 &&
        data.accessoryId.size() <= 16 &&
        data.accessoryId in ['sprout', 'cap', 'crown', 'dino'] &&
        data.hairStyle is string &&
        data.hairStyle.size() >= 1 &&
        data.hairStyle.size() <= 16 &&
        data.hairStyle in ['curls', 'bob', 'spiky', 'puffs'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: GrowthMeasurement
    function isValidGrowthMeasurement(data, childId) {
      return data.keys().hasAll([
          'ownerId',
          'childId',
          'ageMonths',
          'heightCm',
          'weightKg',
          'recordedDate',
          'note',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'childId',
          'ageMonths',
          'heightCm',
          'weightKg',
          'recordedDate',
          'note',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string &&
        data.ownerId.size() >= 1 &&
        data.ownerId.size() <= 128 &&
        data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.childId is string &&
        data.childId.size() >= 1 &&
        data.childId.size() <= 128 &&
        data.childId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.childId == childId &&
        data.ageMonths is number &&
        data.ageMonths >= 24 &&
        data.ageMonths <= 216 &&
        data.heightCm is number &&
        data.heightCm >= 65 &&
        data.heightCm <= 210 &&
        data.weightKg is number &&
        data.weightKg >= 7 &&
        data.weightKg <= 120 &&
        data.recordedDate is string &&
        data.recordedDate.size() == 10 &&
        data.recordedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.note is string &&
        data.note.size() <= 120 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Collection: /children/{childId}
    match /children/{childId} {
      allow get: if isVerifiedUser() &&
        isValidId(childId) &&
        existing().ownerId == request.auth.uid;

      allow list: if isVerifiedUser() &&
        existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser() &&
        isValidId(childId) &&
        isValidChildProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(childId) &&
        isValidChildProfile(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action 1: Update character appearance or name
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'paletteId',
            'accessoryId',
            'hairStyle',
            'updatedAt'
          ]) ||
          // Action 2: Update Age 2 baseline measurements and/or profile details
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'ageTwoHeightCm',
            'ageTwoWeightKg',
            'paletteId',
            'accessoryId',
            'hairStyle',
            'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'ageTwoHeightCm',
            'ageTwoWeightKg',
            'updatedAt'
          ])
        );

      allow delete: if isVerifiedUser() &&
        isValidId(childId) &&
        existing().ownerId == request.auth.uid;

      // Subcollection: /children/{childId}/measurements/{measurementId}
      match /measurements/{measurementId} {
        allow get: if isVerifiedUser() &&
          isValidId(childId) &&
          isValidId(measurementId) &&
          existing().ownerId == request.auth.uid &&
          existing().childId == childId &&
          isParentChildOwner(childId);

        allow list: if isVerifiedUser() &&
          existing().ownerId == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isValidId(childId) &&
          isValidId(measurementId) &&
          isValidGrowthMeasurement(incoming(), childId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isParentChildOwner(childId);

        allow update: if isVerifiedUser() &&
          isValidId(childId) &&
          isValidId(measurementId) &&
          isValidGrowthMeasurement(incoming(), childId) &&
          existing().ownerId == request.auth.uid &&
          incoming().ownerId == existing().ownerId &&
          incoming().childId == existing().childId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'ageMonths',
            'heightCm',
            'weightKg',
            'recordedDate',
            'note',
            'updatedAt'
          ]) &&
          isParentChildOwner(childId);

        allow delete: if isVerifiedUser() &&
          isValidId(childId) &&
          isValidId(measurementId) &&
          existing().ownerId == request.auth.uid &&
          isParentChildOwner(childId);
      }
    }
  }
}
